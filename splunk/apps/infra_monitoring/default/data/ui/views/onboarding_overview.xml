<form version="1.1" theme="dark">
  <label>Data Onboarding Overview</label>
  <description>What data is arriving, and where it is coming from - by host, index, and sourcetype.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>

  <!-- KPI row -->
  <row>
    <panel>
      <title>Total events</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*)</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Hosts reporting</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*) by index host | stats count as hosts</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="useColors">1</option>
        <option name="colorMode">block</option>
        <option name="rangeValues">[0.5]</option>
        <option name="rangeColors">["0xd93f3c","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Indexes receiving data</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*) by index | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Sourcetypes</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*) by sourcetype | stats count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <!-- ingestion over time -->
  <row>
    <panel>
      <title>Events over time, by index</title>
      <chart>
        <search>
          <query>(index=london_* OR index=berlin_* OR index=loc1_*) | timechart span=10m count by index</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">right</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Events</option>
      </chart>
    </panel>
  </row>

  <!-- where from -->
  <row>
    <panel>
      <title>Events by source (host + index)</title>
      <chart>
        <search>
          <query>(index=london_* OR index=berlin_* OR index=loc1_*) | eval source=host." @ ".index | stats count by source | sort - count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
    <panel>
      <title>Events by index</title>
      <chart>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*) by index | sort - count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
      </chart>
    </panel>
    <panel>
      <title>Events by sourcetype</title>
      <chart>
        <search>
          <query>(index=london_* OR index=berlin_* OR index=loc1_*) | stats count by sourcetype | sort - count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
  </row>

  <!-- detail table -->
  <row>
    <panel>
      <title>Data sources — host / index / sourcetype</title>
      <table>
        <search>
          <query>(index=london_* OR index=berlin_* OR index=loc1_*) | stats count as Events, min(_time) as first, max(_time) as last by host index sourcetype | eval "First seen"=strftime(first,"%F %T"), "Last seen"=strftime(last,"%F %T") | rename host as Host, index as Index, sourcetype as Sourcetype | table Host Index Sourcetype Events "First seen" "Last seen" | sort - Events</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">25</option>
      </table>
    </panel>
  </row>
</form>
