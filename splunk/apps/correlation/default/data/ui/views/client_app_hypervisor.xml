<form version="1.1" theme="dark">
  <label>Client → App → Hypervisor</label>
  <description>The path from a user's Windows client, across the Proxmox hypervisor, to the web-app — with live status for each node.</description>

  <!-- Seed status tokens so the diagram never flashes raw $tokens$ before the
       status searches below finish. -->
  <init>
    <set token="cli_status">checking…</set>
    <set token="cli_color">#8b98a5</set>
    <set token="cli_cpu"></set>
    <set token="cli_host">windows-server-2022-london</set>
    <set token="hv_status">checking…</set>
    <set token="hv_color">#8b98a5</set>
    <set token="hv_detail">198.18.3.11</set>
    <set token="app_status">checking…</set>
    <set token="app_color">#8b98a5</set>
    <set token="app_detail">web-app container</set>
  </init>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range (metrics/charts)</label>
      <default><earliest>-60m</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <!-- ============ status searches: each returns ONE row and sets tokens ============ -->
  <search id="cliStatus">
    <query>index=london_metrics sourcetype=perfmon:cpu earliest=-15m latest=now
| stats count as c latest(Value) as cpu latest(_time) as lt latest(host) as host
| eval up=if(c>0 AND (now()-lt)&lt;900,1,0)
| eval cli_status=if(up=1,"ONLINE","OFFLINE"),
       cli_color=if(up=1,"#53a051","#d93f3c"),
       cli_cpu=if(c&gt;0,round(cpu,0)."% CPU","no live metrics"),
       cli_host=coalesce(host,"windows-server-2022-london")
| table cli_status cli_color cli_cpu cli_host</query>
    <earliest>-15m</earliest><latest>now</latest>
    <done>
      <set token="cli_status">$result.cli_status$</set>
      <set token="cli_color">$result.cli_color$</set>
      <set token="cli_cpu">$result.cli_cpu$</set>
      <set token="cli_host">$result.cli_host$</set>
    </done>
  </search>

  <search id="hvStatus">
    <query>index=berlin_proxmox sourcetype=proxmox:api earliest=-15m latest=now
| stats count as c latest(_time) as lt
| eval up=if(c&gt;0 AND (now()-lt)&lt;900,1,0)
| eval hv_status=if(up=1,"REACHABLE","NOT REACHABLE"),
       hv_color=if(up=1,"#53a051","#d93f3c"),
       hv_detail=if(up=1,"Proxmox API responding","198.18.3.11 — no API data")
| table hv_status hv_color hv_detail</query>
    <earliest>-15m</earliest><latest>now</latest>
    <done>
      <set token="hv_status">$result.hv_status$</set>
      <set token="hv_color">$result.hv_color$</set>
      <set token="hv_detail">$result.hv_detail$</set>
    </done>
  </search>

  <search id="appStatus">
    <query>index=berlin_web sourcetype=webapp:probe earliest=-15m latest=now
| stats count as c latest(reachable) as r latest(http_status) as code latest(_time) as lt
| eval up=if(c&gt;0 AND r=1,1,0)
| eval app_status=case(c=0,"UNKNOWN", r=1,"AVAILABLE", true(),"NOT AVAILABLE"),
       app_color=if(up=1,"#53a051","#d93f3c"),
       app_detail=if(c&gt;0,"probe: HTTP ".coalesce(code,"—"),"no probe data")
| table app_status app_color app_detail</query>
    <earliest>-15m</earliest><latest>now</latest>
    <done>
      <set token="app_status">$result.app_status$</set>
      <set token="app_color">$result.app_color$</set>
      <set token="app_detail">$result.app_detail$</set>
    </done>
  </search>

  <!-- ============ the connection diagram (hero) ============ -->
  <row>
    <panel>
      <html>
        <div style="display:flex;align-items:center;justify-content:center;gap:0;flex-wrap:wrap;padding:18px 8px;font-family:Roboto,Arial,sans-serif;">

          <!-- CLIENT -->
          <div style="flex:1 1 260px;max-width:320px;background:#0f1720;border:1px solid #2b3a4a;border-top:5px solid $cli_color$;border-radius:10px;padding:16px;">
            <div style="font-size:11px;letter-spacing:1px;color:#8b98a5;text-transform:uppercase;">Client</div>
            <div style="font-size:18px;font-weight:700;color:#e6edf3;margin:2px 0 8px;">Windows Server</div>
            <div style="font-size:12px;color:#8b98a5;">London · $cli_host$</div>
            <div style="display:inline-block;margin-top:10px;padding:4px 10px;border-radius:14px;background:$cli_color$;color:#0b0f14;font-weight:700;font-size:12px;">$cli_status$</div>
            <div style="margin-top:8px;font-size:13px;color:#cdd9e5;">$cli_cpu$</div>
          </div>

          <!-- link client -> hypervisor -->
          <div style="flex:0 0 70px;text-align:center;color:$hv_color$;font-size:26px;line-height:1;">&#8594;</div>

          <!-- HYPERVISOR -->
          <div style="flex:1 1 260px;max-width:320px;background:#0f1720;border:1px solid #2b3a4a;border-top:5px solid $hv_color$;border-radius:10px;padding:16px;">
            <div style="font-size:11px;letter-spacing:1px;color:#8b98a5;text-transform:uppercase;">Hypervisor</div>
            <div style="font-size:18px;font-weight:700;color:#e6edf3;margin:2px 0 8px;">Proxmox VE</div>
            <div style="font-size:12px;color:#8b98a5;">Berlin · 198.18.3.11</div>
            <div style="display:inline-block;margin-top:10px;padding:4px 10px;border-radius:14px;background:$hv_color$;color:#0b0f14;font-weight:700;font-size:12px;">$hv_status$</div>
            <div style="margin-top:8px;font-size:13px;color:#cdd9e5;">$hv_detail$</div>
          </div>

          <!-- link hypervisor -> app -->
          <div style="flex:0 0 70px;text-align:center;color:$app_color$;font-size:26px;line-height:1;">&#8594;</div>

          <!-- APP -->
          <div style="flex:1 1 260px;max-width:320px;background:#0f1720;border:1px solid #2b3a4a;border-top:5px solid $app_color$;border-radius:10px;padding:16px;">
            <div style="font-size:11px;letter-spacing:1px;color:#8b98a5;text-transform:uppercase;">App</div>
            <div style="font-size:18px;font-weight:700;color:#e6edf3;margin:2px 0 8px;">Web-app container</div>
            <div style="font-size:12px;color:#8b98a5;">LXC on Proxmox · :8080</div>
            <div style="display:inline-block;margin-top:10px;padding:4px 10px;border-radius:14px;background:$app_color$;color:#0b0f14;font-weight:700;font-size:12px;">$app_status$</div>
            <div style="margin-top:8px;font-size:13px;color:#cdd9e5;">$app_detail$</div>
          </div>

        </div>
        <p style="text-align:center;color:#8b98a5;font-size:12px;margin:0 0 6px;">
          A user on the Windows client reaches the web-app running in an LXC container on the Proxmox hypervisor.
          The hypervisor and app light up once Proxmox is reachable and <code>create-webapp-container.sh</code> has run.
          Only <b>gary</b> (global) sees all three; Leo sees the client, Ben the Berlin side.
        </p>
      </html>
    </panel>
  </row>

  <!-- ============ per-node detail: three columns, left to right ============ -->
  <row>
    <!-- CLIENT column -->
    <panel>
      <title>Client — Windows Server (live metrics)</title>
      <chart>
        <title>CPU %</title>
        <search>
          <query>index=london_metrics sourcetype=perfmon:cpu | timechart span=1m avg(Value) as "CPU %"</query>
          <earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.legend.placement">none</option>
      </chart>
      <chart>
        <title>Memory used %</title>
        <search>
          <query>index=london_metrics sourcetype=perfmon:memory counter="% Committed Bytes In Use" | timechart span=1m avg(Value) as "Mem %"</query>
          <earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.legend.placement">none</option>
      </chart>
      <table>
        <title>Windows events by type (last 45 days — run generate-activity.ps1 for fresh ones)</title>
        <search>
          <query>index=london_windows | stats count as events, max(_time) as last_seen by sourcetype
| eval last_seen=strftime(last_seen,"%F %T") | sort - events</query>
          <earliest>-45d</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">10</option>
      </table>
    </panel>

    <!-- HYPERVISOR column -->
    <panel>
      <title>Hypervisor — Proxmox (Berlin)</title>
      <single>
        <title>API reachability (last 15 min)</title>
        <search>
          <query>index=berlin_proxmox sourcetype=proxmox:api earliest=-15m latest=now
| stats count as c | eval s=if(c&gt;0,"REACHABLE","NOT REACHABLE") | fields s</query>
          <earliest>-15m</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="useColors">1</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xd93f3c","0x53a051"]</option>
        <option name="rangeValues">[0]</option>
      </single>
      <html>
        <p style="color:#8b98a5;font-size:12px;">When Proxmox at <b>198.18.3.11</b> is reachable, the
        ubuntu-berlin forwarder polls its API every 60s and this column shows the running
        containers/VMs and node CPU/memory. It is currently unreachable, so the table below is empty.</p>
      </html>
      <table>
        <title>Containers &amp; VMs (from Proxmox API)</title>
        <search>
          <query>index=berlin_proxmox sourcetype=proxmox:api endpoint="cluster/resources" (type=lxc OR type=qemu)
| stats latest(status) as Status latest(type) as Type latest(vmid) as VMID by name
| rename name as Name | table VMID Type Name Status | sort VMID</query>
          <earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <format type="color" field="Status"><colorPalette type="map">{"running":#53a051,"stopped":#d93f3c}</colorPalette></format>
      </table>
    </panel>

    <!-- APP column -->
    <panel>
      <title>App — Web-app container</title>
      <single>
        <title>Availability (probe, last 15 min)</title>
        <search>
          <query>index=berlin_web sourcetype=webapp:probe earliest=-15m latest=now
| stats latest(reachable) as r | eval s=case(isnull(r),"UNKNOWN", r=1,"AVAILABLE", true(),"NOT AVAILABLE") | fields s</query>
          <earliest>-15m</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="useColors">1</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0xd93f3c","0x53a051"]</option>
        <option name="rangeValues">[0]</option>
      </single>
      <table>
        <title>Latest reachability probe</title>
        <search>
          <query>index=berlin_web sourcetype=webapp:probe
| head 1 | eval checked=strftime(_time,"%F %T"),
       state=if(reachable=1,"AVAILABLE","NOT AVAILABLE")
| table checked state target http_status latency_ms</query>
          <earliest>-60m</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
      <chart>
        <title>Reachability over time (1 = up, 0 = down)</title>
        <search>
          <query>index=berlin_web sourcetype=webapp:probe | timechart span=1m latest(reachable) as reachable</query>
          <earliest>$tr.earliest$</earliest><latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
        <option name="charting.axisY.maximumNumber">1</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
  </row>
</form>
