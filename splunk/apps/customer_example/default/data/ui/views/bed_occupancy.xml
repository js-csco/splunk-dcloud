<form version="1.1" theme="dark">
  <label>7. Bettenauslastung — Bed Occupancy (Exec View)</label>
  <description>A leadership-level view of bed occupancy by ward — the kind of KPI dashboard that gets shown to GL/executive management, not just operations.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-30d</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"Überwachung der Bettenauslastung, kann interessant sein für GL."
        <span style="color:#cdd9e5;font-style:normal;"> — a leadership KPI, not just an ops metric.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Hospital-wide occupancy (today)</title>
      <chart>
        <search><query>| makeresults | eval v=87</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,75,90,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Free beds right now</title>
      <single>
        <search><query>| makeresults | eval v=31</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>30-day trend</title>
      <single>
        <search><query>| makeresults | eval v="+4.2 pts vs. last month"</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Occupancy % by ward — 30 days</title>
      <chart>
        <search>
          <query>| makeresults count=30
| streamstats count as i
| eval Day=strftime(relative_time(now(), "-".(30-i)."d"), "%m-%d")
| eval "Surgery"=78+((i%7)*2)
| eval "Internal Medicine"=85+((i%5)*2)
| eval "Radiology / Day Clinic"=60+((i%9)*3)
| table Day "Surgery" "Internal Medicine" "Radiology / Day Clinic"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.axisTitleY.text">Occupancy %</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Bed status breakdown — hospital-wide (now)</title>
      <chart>
        <search>
          <query>| makeresults count=4
| streamstats count as i
| eval Category=case(i=1,"Occupied",i=2,"Free",i=3,"Being cleaned",i=4,"Blocked")
| eval Count=case(i=1,87,i=2,9,i=3,3,i=4,1)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Ward summary — today</title>
      <table>
        <search>
          <query>| makeresults count=3
| streamstats count as i
| eval Ward=case(i=1,"Surgery",i=2,"Internal Medicine",i=3,"Radiology / Day Clinic")
| eval "Licensed beds"=case(i=1,40,i=2,52,i=3,20)
| eval "Occupied"=case(i=1,35,i=2,49,i=3,13)
| eval "Occupancy %"=round('Occupied'/'Licensed beds'*100,1)
| eval Status=case('Occupancy %'&gt;=90,"Near capacity",'Occupancy %'&gt;=75,"Healthy",1=1,"Underutilized")
| table Ward "Licensed beds" Occupied "Occupancy %" Status</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <format type="color" field="Status">
          <colorPalette type="map">{"Near capacity":#d93f3c,"Healthy":#53a051,"Underutilized":#f2b827}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Bed management / RTLS system</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">ADT feed (HL7)</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Nurse call system</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Licensed-bed reference data</span>
        </div>
      </html>
    </panel>
  </row>
</form>
