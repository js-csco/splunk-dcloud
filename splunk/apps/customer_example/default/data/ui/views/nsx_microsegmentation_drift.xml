<form version="1.1" theme="dark">
  <label>6. VMware / NSX — Microsegmentation Drift</label>
  <description>Tie every "it stopped working on the other side again" back to the firewall rule or port-group change that actually caused it.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-24h</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"…ein kleiner Klick und es 'tut auf der anderen Seite wieder nichts', dann hat der Lieferant wieder ein Port gewechselt."
        <span style="color:#cdd9e5;font-style:normal;"> — every change breaks something, with no link back to what caused it.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>DFW / port-group changes (7 days)</title>
      <single>
        <search><query>| makeresults | eval v=12</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Changes that caused an outage</title>
      <single>
        <search><query>| makeresults | eval v=5</query></search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xd93f3c"]</option>
        <option name="rangeValues">[1]</option>
      </single>
    </panel>
    <panel>
      <title>Change success rate (no outage)</title>
      <chart>
        <search><query>| makeresults | eval v=58</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,50,80,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>App connectivity around the rule change</title>
      <chart>
        <search>
          <query>| makeresults count=24
| streamstats count as i
| eval Hour=strftime(relative_time(now(), "-".(24-i)."h"), "%H:00")
| eval "App -&gt; DB reachable"=if(i&gt;=12 AND i&lt;=13, 0, 1)
| table Hour "App -&gt; DB reachable"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.axisY.maximumNumber">1</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Changes by team (7 days)</title>
      <chart>
        <search>
          <query>| makeresults count=3
| streamstats count as i
| eval Category=case(i=1,"vendor.integrations",i=2,"network.admin",i=3,"app.team")
| eval Count=case(i=1,7,i=2,2,i=3,3)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Example: rule change immediately followed by an app outage</title>
      <table>
        <search>
          <query>| makeresults count=4
| streamstats count as i
| eval Time=strftime(relative_time(now(), "-".(240-i*20)."m"), "%H:%M")
| eval Source=case(i=1,"NSX Manager (DFW)",i=2,"App probe",i=3,"NSX Manager (DFW)",i=4,"App probe")
| eval Event=case(
    i=1,"Rule 'Allow-App-to-DB-5432' modified (source range narrowed)",
    i=2,"webapp -&gt; db:5432 probe FAILED",
    i=3,"Rule reverted by network.admin",
    i=4,"webapp -&gt; db:5432 probe OK")
| table Time Source Event
| sort Time</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">NSX Manager (DFW events)</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">vCenter events</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Change management / CMDB</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">App connectivity probes</span>
        </div>
      </html>
    </panel>
  </row>
</form>
