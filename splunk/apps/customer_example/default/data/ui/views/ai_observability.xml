<form version="1.1" theme="dark">
  <label>9. AI Observability &amp; Governance</label>
  <description>A governance-first view of AI usage — cost, latency, and guardrail hits — built to de-risk AI adoption for a leadership team that currently has the handbrake on.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-7d</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"AI Observability ist sehr interessant, GL hat da zur Zeit aber etwas die Handbremse drauf, aufgrund Unsicherheit."
        <span style="color:#cdd9e5;font-style:normal;"> — the gap is visibility and guardrails, not the technology.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Governance confidence score</title>
      <chart>
        <search><query>| makeresults | eval v=91</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,60,80,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>AI requests (7 days)</title>
      <single>
        <search><query>| makeresults | eval v=48213</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Guardrail hits (blocked)</title>
      <single>
        <search><query>| makeresults | eval v=7</query></search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf2b827"]</option>
        <option name="rangeValues">[1]</option>
      </single>
    </panel>
    <panel>
      <title>Spend (7 days)</title>
      <single>
        <search><query>| makeresults | eval v=1284</query></search>
        <option name="unit">CHF</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Usage &amp; spend by team (7 days)</title>
      <chart>
        <search>
          <query>| makeresults count=4
| streamstats count as i
| eval Team=case(i=1,"Radiology-AI-Pipeline",i=2,"Clinical-Docs-Assistant",i=3,"IT-Helpdesk-Bot",i=4,"HR-Screening (paused)")
| eval "Requests"=case(i=1,28400,i=2,14200,i=3,5600,i=4,13)
| eval "Spend (CHF)"=case(i=1,712,i=2,398,i=3,161,i=4,13)
| table Team "Requests" "Spend (CHF)"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Guardrail hit types (7 days)</title>
      <chart>
        <search>
          <query>| makeresults count=3
| streamstats count as i
| eval Category=case(i=1,"PII / PHI leakage",i=2,"Internal-confidential",i=3,"Policy / other")
| eval Count=case(i=1,3,i=2,2,i=3,2)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Guardrail hits — what governance is actually catching</title>
      <table>
        <search>
          <query>| makeresults count=3
| streamstats count as i
| eval Time=strftime(relative_time(now(), "-".(i*2)."d"), "%Y-%m-%d")
| eval Team=case(i=1,"Clinical-Docs-Assistant",i=2,"HR-Screening (paused)",i=3,"Clinical-Docs-Assistant")
| eval Finding=case(i=1,"Unredacted patient name",i=2,"Candidate SSN in prompt",i=3,"Internal-only pricing")
| eval Action=case(i=1,"Blocked, team notified",i=2,"Blocked, pilot escalated to GL",i=3,"Blocked, logged")
| table Time Team Finding Action
| sort Time</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">LLM / API gateway logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Guardrail / DLP scan logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Model registry</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Identity / access data</span>
        </div>
      </html>
    </panel>
  </row>
</form>
