<form version="1.1" theme="dark">
  <label>8. Swiss Data Residency &amp; Cloud Compliance</label>
  <description>Prove, on every cloud egress, that "processed in Switzerland" actually held — instead of assuming it did.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-24h</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"Solange es in der Schweiz verarbeitet wird, darf es auch in die Cloud raus."
        <span style="color:#cdd9e5;font-style:normal;"> — a policy today, not yet a monitored control.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Compliant (processed in CH first)</title>
      <chart>
        <search><query>| makeresults | eval v=99.7</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,90,98,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Egress events — last 24h</title>
      <single>
        <search><query>| makeresults | eval v=1842</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Policy violations flagged</title>
      <single>
        <search><query>| makeresults | eval v=1</query></search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xd93f3c"]</option>
        <option name="rangeValues">[1]</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Egress volume by processing region (24h)</title>
      <chart>
        <search>
          <query>| makeresults count=24
| streamstats count as i
| eval Hour=strftime(relative_time(now(), "-".(24-i)."h"), "%H:00")
| eval "Switzerland"=70+(i%10)
| eval "Other region (flagged)"=if(i=15,4,0)
| table Hour "Switzerland" "Other region (flagged)"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.seriesColors">[0x53a051,0xd93f3c]</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Egress by destination region (24h)</title>
      <chart>
        <search>
          <query>| makeresults count=2
| streamstats count as i
| eval Category=case(i=1,"Switzerland",i=2,"Other region (flagged)")
| eval Count=case(i=1,1837,i=2,5)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Example: cloud egress events</title>
      <table>
        <search>
          <query>| makeresults count=5
| streamstats count as i
| eval Time=strftime(relative_time(now(), "-".(300-i*30)."m"), "%H:%M")
| eval Application=case(i=1,"Imaging-AI-Pipeline",i=2,"HR-Analytics",i=3,"Imaging-AI-Pipeline",i=4,"Backup-Sync",i=5,"Imaging-AI-Pipeline")
| eval "Processed in"=case(i=1,"Switzerland",i=2,"Switzerland",i=3,"Switzerland",i=4,"Switzerland",i=5,"West Europe (Ireland)")
| eval "Cloud destination"=case(i=1,"Azure Blob (CH-North)",i=2,"Azure Blob (CH-North)",i=3,"Azure Blob (CH-North)",i=4,"Azure Blob (CH-North)",i=5,"Azure Blob (West Europe)")
| eval Status=if(i=5,"VIOLATION","OK")
| table Time Application "Processed in" "Cloud destination" Status
| sort Time</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <format type="color" field="Status">
          <colorPalette type="map">{"VIOLATION":#d93f3c,"OK":#53a051}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Proxy / CASB logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">DLP / data classification tags</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Cloud provider audit logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Egress firewall / SASE logs</span>
        </div>
      </html>
    </panel>
  </row>
</form>
