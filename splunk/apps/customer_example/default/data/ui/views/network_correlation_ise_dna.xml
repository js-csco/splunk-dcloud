<form version="1.1" theme="dark">
  <label>4. Network Correlation — ISE / DNA Center</label>
  <description>Line up identity (ISE), assurance (DNA Center) and the wire (switches) into one incident timeline instead of three separate consoles.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-4h</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"…Fehlende Korrelationen der Netzwerkkomponenten wie ISE, DNA usw."
        <span style="color:#cdd9e5;font-style:normal;"> — each system tells part of the story; nobody looks at them together.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Correlated incidents (7 days)</title>
      <single>
        <search><query>| makeresults | eval v=9</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Auth failures linked to a network-health drop</title>
      <single>
        <search><query>| makeresults | eval v=4</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Avg client health score (fleet)</title>
      <chart>
        <search><query>| makeresults | eval v=87</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,60,85,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Client health score around the incident (DNA Center)</title>
      <chart>
        <search>
          <query>| makeresults count=20
| streamstats count as i
| eval Minute=strftime(relative_time(now(), "-".(20-i)."m"), "%H:%M")
| eval "Client health score"=case(i&gt;=9 AND i&lt;=13, 34, 1=1, 90+(i%3))
| table Minute "Client health score"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Auth outcome over time (ISE)</title>
      <chart>
        <search>
          <query>| makeresults count=20
| streamstats count as i
| eval Minute=strftime(relative_time(now(), "-".(20-i)."m"), "%H:%M")
| eval "Auth success"=if(i&gt;=9 AND i&lt;=12,0,1)
| eval "Auth failure"=if(i&gt;=9 AND i&lt;=12,1,0)
| table Minute "Auth success" "Auth failure"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Correlated incidents by root cause (7 days)</title>
      <chart>
        <search>
          <query>| makeresults count=4
| streamstats count as i
| eval Category=case(i=1,"Cert / auth issue",i=2,"Port-security violation",i=3,"AP / wireless roam",i=4,"Config drift")
| eval Count=case(i=1,4,i=2,2,i=3,2,i=4,1)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Example: one incident, three consoles</title>
      <table>
        <search>
          <query>| makeresults count=5
| streamstats count as i
| eval Time=strftime(relative_time(now(), "-".(300-i*40)."s"), "%H:%M:%S")
| eval Source=case(i=1,"ISE",i=2,"Switch",i=3,"DNA Center",i=4,"ISE",i=5,"DNA Center")
| eval Event=case(
    i=1,"802.1X auth failed (cert expired)",
    i=2,"Gi1/0/24 err-disabled",
    i=3,"Health score 92 -&gt; 34",
    i=4,"Re-authenticated after cert renewal",
    i=5,"Health score 34 -&gt; 90")
| table Time Source Event
| sort Time</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Cisco ISE</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Cisco DNA Center</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Switch / router syslog &amp; SNMP</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Wireless LAN controller</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Correlate by: MAC / username</span>
        </div>
      </html>
    </panel>
  </row>
</form>
