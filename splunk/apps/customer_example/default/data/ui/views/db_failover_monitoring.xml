<form version="1.1" theme="dark">
  <label>2. Redundant DB Servers — Failover Visibility</label>
  <description>See why a redundant database pair actually failed over — instead of only knowing that it did.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="tr">
      <label>Time range</label>
      <default><earliest>-24h</earliest><latest>now</latest></default>
    </input>
  </fieldset>

  <row>
    <panel>
      <html>
        <p style="margin:0;color:#8b98a5;font-style:italic;">"…Redundante Datenbankserver, die aktuell viel zu wenig überwacht werden…"
        <span style="color:#cdd9e5;font-style:normal;"> — the standby took over; nobody could say why.</span></p>
      </html>
    </panel>
  </row>

  <row>
    <panel>
      <title>Cluster health (uptime, 30d)</title>
      <chart>
        <search><query>| makeresults | eval v=99.6</query></search>
        <option name="charting.chart">radialGauge</option>
        <option name="charting.chart.rangeValues">[0,95,99,100]</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Failovers (30 days)</title>
      <single>
        <search><query>| makeresults | eval v=2</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Time to root cause — before vs. with Splunk</title>
      <single>
        <search><query>| makeresults | eval v="Hours -&gt; Minutes"</query></search>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>CPU on both nodes around the failover</title>
      <chart>
        <search>
          <query>| makeresults count=40
| streamstats count as i
| eval Minute=strftime(relative_time(now(), "-".(40-i)."m"), "%H:%M")
| eval "db-primary-01 CPU %"=case(i&gt;=18 AND i&lt;=24, 92+ (i%3*2), 1=1, 22+(i%5))
| eval "db-standby-01 CPU %"=case(i&gt;22, 55+(i%6), 1=1, 18+(i%4))
| table Minute "db-primary-01 CPU %" "db-standby-01 CPU %"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.axisY.maximumNumber">100</option>
        <option name="charting.axisTitleY.text">CPU %</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Cluster role over time (0=standby, 1=active)</title>
      <chart>
        <search>
          <query>| makeresults count=40
| streamstats count as i
| eval Minute=strftime(relative_time(now(), "-".(40-i)."m"), "%H:%M")
| eval "db-primary-01"=if(i&lt;22,1,0)
| eval "db-standby-01"=if(i&lt;22,0,1)
| table Minute "db-primary-01" "db-standby-01"</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisY.maximumNumber">1</option>
        <option name="charting.axisY.minimumNumber">0</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Failover trigger reasons (90 days, 5 events)</title>
      <chart>
        <search>
          <query>| makeresults count=3
| streamstats count as i
| eval Category=case(i=1,"CPU spike",i=2,"Heartbeat lost",i=3,"Manual / planned")
| eval Count=case(i=1,2,i=2,2,i=3,1)
| table Category Count</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
        <option name="drilldown">none</option>
      </chart>
    </panel>
    <panel>
      <title>Latest failover — at a glance</title>
      <table>
        <search>
          <query>| makeresults count=1
| eval "Failover time"=strftime(relative_time(now(),"-38m"),"%Y-%m-%d %H:%M:%S")
| eval Primary="db-primary-01", "Now active"="db-standby-01", Trigger="CPU spike + missed heartbeats", "Missed heartbeats"=3, Reconnects=214
| table "Failover time" Primary "Now active" Trigger "Missed heartbeats" Reconnects</query>
          <earliest>$tr.earliest$</earliest>
          <latest>$tr.latest$</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Data sources needed</title>
      <html>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">DB / cluster logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Host / OS metrics</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">Network heartbeat / VIP logs</span>
          <span style="background:#1b2430;color:#cdd9e5;padding:4px 10px;border-radius:12px;font-size:12px;border:1px solid #2b3a4a;">App connection logs</span>
        </div>
      </html>
    </panel>
  </row>
</form>
