# Make the app's knowledge objects visible globally and readable by all,
# writable by admin/power. Keeps the lab simple and shareable.

[]
access = read : [ * ], write : [ admin, power ]
export = system

[views]
export = system

[nav]
export = system

# The Save to GitHub dashboard is admin-only (it pushes to the repo).
[views/save_to_github]
access = read : [ admin ], write : [ admin ]

# Save-to-GitHub request queue (admin/power only). The dashboard writes here via
# outputlookup; the git-push watcher scripted input drains it.
[collections/git_save_requests]
export = system
access = read : [ admin, power ], write : [ admin, power ]

[transforms/git_save_requests_lk]
export = system
access = read : [ admin, power ], write : [ admin, power ]

# DCloudLab data model - global + readable by all (per-index RBAC still applies
# at search time, so Leo/Ben only pivot over their own data).
[datamodels/DCloudLab]
export = system
access = read : [ * ], write : [ admin, power ]
