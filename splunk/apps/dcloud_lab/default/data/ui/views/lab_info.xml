<dashboard version="1.1" theme="dark">
  <label>Lab Info</label>
  <description>The lab at a glance — what it is, every host and how to reach it, the demo logins, and the topology.</description>

  <!-- ===== live status strip ===== -->
  <row>
    <panel>
      <title>Events (last 24h)</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*)</query>
          <earliest>-24h</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Lab indexes</title>
      <single>
        <search>
          <query>| rest /services/data/indexes | search (title=london_* OR title=berlin_* OR title=loc1_*) | stats count</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Hosts sending (24h)</title>
      <single>
        <search>
          <query>| tstats dc(host) as hosts where (index=london_* OR index=berlin_* OR index=loc1_*)</query>
          <earliest>-24h</earliest><latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Splunk uptime</title>
      <single>
        <search>
          <query>| rest /services/server/info | eval uptime_hours=round(startup_time_delta/3600,1) | fields uptime_hours</query>
        </search>
        <option name="unit">h</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

