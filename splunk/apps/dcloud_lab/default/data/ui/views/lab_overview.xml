<dashboard version="1.1" theme="dark">
  <label>Lab Overview</label>
  <description>Health and ingestion overview for the dCloud Splunk lab.</description>

  <row>
    <panel>
      <title>Total events in lab indexes (last 24h)</title>
      <single>
        <search>
          <query>| tstats count where index IN (linux_logs, proxmox, network, demo) earliest=-24h</query>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Lab indexes configured</title>
      <single>
        <search>
          <query>| rest /services/data/indexes | search title IN (linux_logs, proxmox, network, demo) | stats count</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Splunk uptime</title>
      <single>
        <search>
          <query>| rest /services/server/info | eval uptime_hours=round(startup_time_delta/3600,1) | fields uptime_hours</query>
        </search>
        <option name="unit">h</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Events per lab index (last 24h)</title>
      <chart>
        <search>
          <query>| tstats count where index IN (linux_logs, proxmox, network, demo) by index earliest=-24h | sort - count</query>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
    <panel>
      <title>Ingestion over time (all lab indexes, last 24h)</title>
      <chart>
        <search>
          <query>| tstats count where index IN (linux_logs, proxmox, network, demo) by _time span=15m | timechart span=15m sum(count) as events</query>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Events</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent internal errors (last 60m)</title>
      <table>
        <search>
          <query>index=_internal log_level IN (ERROR, WARN) earliest=-60m | stats count by component log_level | sort - count | head 20</query>
        </search>
        <option name="drilldown">none</option>
        <option name="count">20</option>
      </table>
    </panel>
  </row>
</dashboard>
