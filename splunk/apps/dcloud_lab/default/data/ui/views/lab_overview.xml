<dashboard version="1.1" theme="dark">
  <label>Ingestion &amp; Health</label>
  <description>Ingestion volume and Splunk health for the dCloud lab (per-location indexes).</description>

  <row>
    <panel>
      <title>Total events in lab indexes (last 24h)</title>
      <single>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*)</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0x53a051"]</option>
      </single>
    </panel>
    <panel>
      <title>Lab indexes configured</title>
      <single>
        <search>
          <query>| rest /services/data/indexes | search (title=london_* OR title=berlin_* OR title=loc1_*) | stats count</query>
        </search>
        <option name="drilldown">none</option>
      </single>
    </panel>
    <panel>
      <title>Splunk uptime</title>
      <single>
        <search>
          <query>| rest /services/server/info | eval uptime_hours=round(startup_time_delta/3600,1) | fields uptime_hours</query>
        </search>
        <option name="unit">h</option>
        <option name="drilldown">none</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>Events per location index (last 24h)</title>
      <chart>
        <search>
          <query>| tstats count where (index=london_* OR index=berlin_* OR index=loc1_*) by index | sort - count</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.legend.placement">none</option>
      </chart>
    </panel>
    <panel>
      <title>Ingestion over time (all locations, last 24h)</title>
      <chart>
        <search>
          <query>(index=london_* OR index=berlin_* OR index=loc1_*) | timechart span=15m count by index</query>
          <earliest>-24h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Events</option>
      </chart>
    </panel>
  </row>

</dashboard>
