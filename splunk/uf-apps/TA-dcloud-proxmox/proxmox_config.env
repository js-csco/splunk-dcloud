# Non-secret Proxmox connection defaults for the Berlin poller (poll_proxmox.py).
# Precedence: this file -> $SPLUNK_HOME/var/lib/dcloud/proxmox.env -> env vars.
#
# The PASSWORD (or an API TOKEN) is a SECRET - do NOT put it here (this file is
# committed). install-uf.sh berlin prompts for it and writes it out-of-repo to
#   /opt/splunkforwarder/var/lib/dcloud/proxmox.env   (chmod 600, not committed)
# Or set it by hand there, then restart the forwarder:
#   sudo mkdir -p /opt/splunkforwarder/var/lib/dcloud
#   echo 'PROXMOX_PASSWORD=cisco' | sudo tee /opt/splunkforwarder/var/lib/dcloud/proxmox.env
#   sudo /opt/splunkforwarder/bin/splunk restart
# Token alternative (preferred for real use): PROXMOX_TOKEN=user@realm!tokenid=uuid
#
# NOTE: PROXMOX_USER must include the realm - root logs in as root@pam.
PROXMOX_HOST=198.18.3.11
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_SITE=berlin
