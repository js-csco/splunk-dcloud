  "visualizations": {
    "viz_global": {
      "type": "splunk.singlevalue",
      "options": {
        "majorColor": "> majorValue | rangeValue(color_global)",
        "unit": "%",
        "sparklineDisplay": "off",
        "backgroundColor": "#171D21"
      },
      "context": {
        "color_global": [
          {
            "to": 50,
            "value": "#D41F1F"
          },
          {
            "from": 50,
            "value": "#53A051"
