{
  "title": "dCloud - Service Topology",
  "description": "Live service health - green = reachable, red = down. Tiles read the same probe/heartbeat signals as the ITSI tree.",
  "defaults": {
    "dataSources": {
      "global": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          },
          "refreshType": "delay",
          "refresh": "$global_refresh_rate$"
        }
      }
    }
  },
  "layout": {
    "options": {
      "showTitleAndDescription": true
    },
    "globalInputs": [
      "input_global_trp",
      "input_global_refresh_rate"
    ],
    "tabs": {
      "items": [
        {
          "layoutId": "layout_1",
          "label": "Topology"
        }
      ]
    },
    "layoutDefinitions": {
      "layout_1": {
        "type": "absolute",
        "options": {
          "width": 1920,
          "height": 1080,
          "backgroundColor": "#0b0e13"
        },
        "structure": [
          {
            "item": "viz_global",
            "type": "block",
