{
  "title": "dCloud - Service Topology",
  "description": "Live service health wall - green = reachable, red = down. Same signals as the ITSI tree.",
  "defaults": {
    "dataSources": {
      "global": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          },
          "refreshType": "delay",
          "refresh": "$global_refresh_rate$"
        }
      }
    }
  },
  "layout": {
    "options": {
      "showTitleAndDescription": true
    },
    "globalInputs": [
      "input_global_trp",
      "input_global_refresh_rate"
    ],
    "tabs": {
      "items": [
        {
          "layoutId": "layout_1",
          "label": "Topology"
