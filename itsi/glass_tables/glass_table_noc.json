{
  "title": "dCloud - NOC Ops Wall",
  "description": "Live NOC wall - green = reachable, red = down. Same signals as the ITSI service tree.",
  "defaults": {
    "dataSources": {
      "global": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          },
          "refreshType": "delay",
          "refresh": "$global_refresh_rate$"
        }
      }
    }
  },
  "layout": {
    "options": {
      "showTitleAndDescription": true
    },
    "globalInputs": [
      "input_global_trp",
      "input_global_refresh_rate"
    ],
    "tabs": {
      "items": [
        {
          "layoutId": "layout_1",
          "label": "Ops Wall"
        }
      ]
    },
