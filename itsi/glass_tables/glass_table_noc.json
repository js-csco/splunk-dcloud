        "majorValue": "> primary | seriesByName('status')",
        "backgroundColor": "> primary | seriesByName('v') | rangeValue(bg)",
        "majorColor": "#ffffff",
        "majorFontSize": 56,
        "sparklineDisplay": "off",
        "numberPrecision": 0,
        "underLabel": "GLOBAL SERVICE HEALTH",
