  "dataSources": {
    "ds_web": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=webapp-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Web Service"
    },
    "ds_db": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=db-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Database Service"
    },
    "ds_proxmox": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=proxmox-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Proxmox Hypervisor"
    },
    "ds_ubuntu_b": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_metrics sourcetype=linux:metrics host=ubuntu-berlin | stats count as c | eval v=if(c>0,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Ubuntu Berlin"
    },
    "ds_router_b": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=cat8kv-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Router Berlin"
    },
    "ds_ubuntu_l": {
      "type": "ds.search",
      "options": {
        "query": "index=london_metrics sourcetype=linux:metrics host=ubuntu-london | stats count as c | eval v=if(c>0,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Ubuntu London"
    },
    "ds_router_l": {
      "type": "ds.search",
      "options": {
        "query": "index=london_web sourcetype=port:probe host=cat8kv-london | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Router London"
    },
    "ds_splunk": {
      "type": "ds.search",
      "options": {
        "query": "index=loc1_metrics sourcetype=linux:metrics | stats count as c | eval v=if(c>0,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Splunk Core"
    },
    "ds_cpu_ub_b": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_metrics sourcetype=linux:metrics host=ubuntu-berlin | stats latest(cpu_pct) as raw | eval v=coalesce(raw,0), status=round(v).\"%\" | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Ubuntu Berlin CPU"
    },
    "ds_cpu_ub_l": {
      "type": "ds.search",
      "options": {
        "query": "index=london_metrics sourcetype=linux:metrics host=ubuntu-london | stats latest(cpu_pct) as raw | eval v=coalesce(raw,0), status=round(v).\"%\" | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Ubuntu London CPU"
    },
    "ds_dirapp": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults \n| appendcols [ search index=berlin_web sourcetype=port:probe host=webapp-berlin earliest=-15m | stats count as c latest(open) as o | eval f0=if(c>0 AND o=1,1,0) | fields f0 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=db-berlin earliest=-15m | stats count as c latest(open) as o | eval f1=if(c>0 AND o=1,1,0) | fields f1 ] \n| eval v=if(f0=1 AND f1=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Directory App"
    },
    "ds_berlin_infra": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults \n| appendcols [ search index=berlin_web sourcetype=port:probe host=proxmox-berlin earliest=-15m | stats count as c latest(open) as o | eval f0=if(c>0 AND o=1,1,0) | fields f0 ] \n| appendcols [ search index=berlin_metrics sourcetype=linux:metrics host=ubuntu-berlin earliest=-15m | stats count as c | eval f1=if(c>0,1,0) | fields f1 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=cat8kv-berlin earliest=-15m | stats count as c latest(open) as o | eval f2=if(c>0 AND o=1,1,0) | fields f2 ] \n| eval v=if(f0=1 AND f1=1 AND f2=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Berlin Infrastructure"
    },
    "ds_berlin": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults \n| appendcols [ search index=berlin_web sourcetype=port:probe host=webapp-berlin earliest=-15m | stats count as c latest(open) as o | eval f0=if(c>0 AND o=1,1,0) | fields f0 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=db-berlin earliest=-15m | stats count as c latest(open) as o | eval f1=if(c>0 AND o=1,1,0) | fields f1 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=proxmox-berlin earliest=-15m | stats count as c latest(open) as o | eval f2=if(c>0 AND o=1,1,0) | fields f2 ] \n| appendcols [ search index=berlin_metrics sourcetype=linux:metrics host=ubuntu-berlin earliest=-15m | stats count as c | eval f3=if(c>0,1,0) | fields f3 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=cat8kv-berlin earliest=-15m | stats count as c latest(open) as o | eval f4=if(c>0 AND o=1,1,0) | fields f4 ] \n| eval v=if(f0=1 AND f1=1 AND f2=1 AND f3=1 AND f4=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Berlin"
    },
    "ds_london": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults \n| appendcols [ search index=london_metrics sourcetype=linux:metrics host=ubuntu-london earliest=-15m | stats count as c | eval f0=if(c>0,1,0) | fields f0 ] \n| appendcols [ search index=london_web sourcetype=port:probe host=cat8kv-london earliest=-15m | stats count as c latest(open) as o | eval f1=if(c>0 AND o=1,1,0) | fields f1 ] \n| eval v=if(f0=1 AND f1=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "London"
    },
    "ds_loc1": {
      "type": "ds.search",
      "options": {
        "query": "index=loc1_metrics sourcetype=linux:metrics | stats count as c | eval v=if(c>0,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Location 1"
    },
    "ds_global": {
      "type": "ds.search",
      "options": {
        "query": "| makeresults \n| appendcols [ search index=berlin_web sourcetype=port:probe host=webapp-berlin earliest=-15m | stats count as c latest(open) as o | eval f0=if(c>0 AND o=1,1,0) | fields f0 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=db-berlin earliest=-15m | stats count as c latest(open) as o | eval f1=if(c>0 AND o=1,1,0) | fields f1 ] \n| appendcols [ search index=berlin_web sourcetype=port:probe host=proxmox-berlin earliest=-15m | stats count as c latest(open) as o | eval f2=if(c>0 AND o=1,1,0) | fields f2 ] \n| appendcols [ search index=berlin_metrics sourcetype=linux:metrics host=ubuntu-berlin earliest=-15m | stats count as c | eval f3=if(c>0,1,0) | fields f3 ] \n| appendcols [ search index=london_metrics sourcetype=linux:metrics host=ubuntu-london earliest=-15m | stats count as c | eval f4=if(c>0,1,0) | fields f4 ] \n| eval v=if(f0=1 AND f1=1 AND f2=1 AND f3=1 AND f4=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Global IT Operations"
    }
