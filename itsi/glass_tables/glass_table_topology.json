{
  "title": "dCloud - Service Topology",
  "description": "Service dependency map - node color is live reachability; edges show blast radius.",
  "defaults": {
    "dataSources": {
      "global": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          },
          "refreshType": "delay",
          "refresh": "$global_refresh_rate$"
        }
      }
    }
  },
