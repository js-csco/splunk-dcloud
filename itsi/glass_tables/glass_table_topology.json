  "dataSources": {
    "ds_web": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=webapp-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Web Service"
    },
    "ds_db": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=db-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
          "earliest": "-15m",
          "latest": "now"
        }
      },
      "name": "Database Service"
    },
    "ds_proxmox": {
      "type": "ds.search",
      "options": {
        "query": "index=berlin_web sourcetype=port:probe host=proxmox-berlin | stats count as c latest(open) as o | eval v=if(c>0 AND o=1,100,0), status=if(v>=50,\"UP\",\"DOWN\") | table status v",
        "queryParameters": {
