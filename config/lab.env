# ---------------------------------------------------------------------------
# lab.env - tunables for the dCloud Splunk lab deployment
#
# These are shell variables sourced by bootstrap.sh / apply.sh.
# Everything here is safe to commit (no real secrets). Anything sensitive
# should come from the environment at boot time, NOT from this file.
# ---------------------------------------------------------------------------

# Where the repo gets checked out on the dCloud VM at boot.
: "${DCLOUD_WORKDIR:=/opt/dcloud-splunk}"

# Which GitHub repo + branch to pull the deployment from.
# Override these in the dCloud startup command if you use a different branch.
: "${DCLOUD_REPO:=js-csco/splunk-dcloud}"
: "${DCLOUD_BRANCH:=claude/splunk-lab-deployment-u5s91k}"

# Splunk install location + the OS user Splunk runs as.
: "${SPLUNK_HOME:=/opt/splunk}"
: "${SPLUNK_USER:=splunk}"

# Splunk admin credentials (used only for REST/CLI calls that need auth).
# Defaults match the dCloud demo image. Prefer overriding via the environment.
: "${SPLUNK_ADMIN_USER:=admin}"
: "${SPLUNK_ADMIN_PASSWORD:=C1sco12345}"

# The name of the app this repo deploys into Splunk.
: "${LAB_APP:=dcloud_lab}"
